# /etc/systemd/system/ripostiglio.service
[Unit]
Description=Ripostiglio API
After=network-online.target postgresql.service

[Service]
User=pi
WorkingDirectory=/home/pi/ripostiglio-server
ExecStart=/home/pi/ripostiglio-server/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure

[Install]
WantedBy=multi-user.target
